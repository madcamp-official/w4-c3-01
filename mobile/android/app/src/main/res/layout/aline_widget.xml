<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/aline_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/aline_widget_background"
  android:clipToOutline="true"
  android:padding="0dp">

  <ImageView
    android:id="@+id/aline_widget_photo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/aline_widget_latest_post"
    android:scaleType="centerCrop"
    android:visibility="gone" />

  <ImageView
    android:id="@+id/aline_widget_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aline_widget_scrim"
    android:contentDescription="@null"
    android:importantForAccessibility="no"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/aline_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="ALine"
      android:textColor="#FFF9ED"
      android:textSize="22sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center"
      android:text="@string/aline_widget_empty"
      android:textColor="#D7CEBA"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/aline_widget_meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="56dp"
    android:paddingBottom="14dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/aline_widget_author"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/aline_widget_time"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="1dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9E4DB"
      android:textSize="10sp" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/aline_widget_camera"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_gravity="bottom|end"
    android:layout_margin="12dp"
    android:background="@drawable/aline_widget_camera_background"
    android:contentDescription="@string/aline_widget_open_camera"
    android:padding="9dp">

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:src="@android:drawable/ic_menu_camera"
      android:tint="#FFF9ED" />
  </FrameLayout>
</FrameLayout>
